  "indicators": [
    {
      "id": "X11",
      "label": "边坡高度",
      "category": "建设规模",
      "source_pages": [
        18
      ],
      "notes": "（1）土质边坡H≥60m、岩质边坡H≥80m时，基本分值确定为100，其他分值可按高度线性内插计算取值。（2）在每一档分值给定时，当单级坡（两碎落台间距）土质边坡h≥12m、岩质边坡h≥15m时取大值；当单级土质边坡h≤6m、岩质边坡h≤8m时取小值；当单级土质边坡高度h=8m、岩质边坡h=10m时，取中间值。其他情况按分级高度线性内插。（3）当用上述两种标准给定分值不一致，采用大值。",
      "grades": [
        {
          "id": "very_high",
          "min_value": "75",
          "max_value": "100",
          "description": "土质边坡H≥40m，岩质边坡H≥60m"
        },
        {
          "id": "high",
          "min_value": "50",
          "max_value": "74",
          "description": "土质边坡30m≤H<40m，岩质边坡40m≤H<60m"
        },
        {
          "id": "moderate",
          "min_value": "25",
          "max_value": "49",
          "description": "土质边坡20m≤H<30m，岩质边坡30m≤H<40m"
        },
        {
          "id": "low",
          "min_value": "0",
          "max_value": "24",
          "description": "土质边坡H<20m，岩质边坡H<30m"
        }
      ]
    },
    {
      "id": "X12",
      "label": "坡形坡率",
      "category": "建设规模",
      "source_pages": [
        18
      ],
      "notes": "自然坡斜坡的比拟坡是广义的概念，可选择当地极限稳定坡、稳定坡或所在自然坡的坡度。Δα≥25°时，分值为100，其他分值可按Δα实际值线性内插取值。",
      "grades": [
        {
          "id": "very_high",
          "min_value": "75",
          "max_value": "100",
          "description": "路堑边坡超过所在自然斜坡比拟坡度值Δα≥15°"
        },
        {
          "id": "high",
          "min_value": "50",
          "max_value": "74",
          "description": "10°≤Δα<15°"
        },
        {
          "id": "moderate",
          "min_value": "25",
          "max_value": "49",
          "description": "5°≤Δα<10°"
        },
        {
          "id": "low",
          "min_value": "0",
          "max_value": "24",
          "description": "Δα<5°"
        }
      ]
    },
    {
      "id": "X21",
      "label": "地层岩性",
      "category": "地质条件",
      "source_pages": [
        19
      ],
      "notes": "易滑及软弱地层，是指煤系地层岩组、泥质岩岩组（泥质粉砂岩、砂质泥岩、泥岩、泥灰岩、页岩等）、残积层、第四系重力堆积层；基岩，是指除去“易滑及软弱地层”的基岩；地层分布复杂者取大值；反之，取小值。",
      "grades": [
        {
          "id": "very_high",
          "min_value": "75",
          "max_value": "100",
          "description": "易滑及软弱地层"
        },
        {
          "id": "high",
          "min_value": "50",
          "max_value": "74",
          "description": "全风化层基岩"
        },
        {
          "id": "moderate",
          "min_value": "25",
          "max_value": "49",
          "description": "强风化层基岩"
        },
        {
          "id": "low",
          "min_value": "0",
          "max_value": "24",
          "description": "弱风化层基岩"
        }
      ]
    },
    {
      "id": "X22",
      "label": "坡体结构",
      "category": "地质条件",
      "source_pages": [
        19
      ],
      "notes": "根据结构面贯通性和发育程度取值。缓倾的软弱结构面是指结构面的倾角小于路堑边坡坡角。结构面及其组合面的倾向与边坡倾向之间的夹角β=0°取大值，β=45°取中间，β=60°取小值，其它的值建议用线性内插法确定。",
      "grades": [
        {
          "id": "very_high",
          "min_value": "75",
          "max_value": "100",
          "description": "坡体中存在顺坡向缓倾的软弱结构面或组合体：贯通"
        },
        {
          "id": "high",
          "min_value": "50",
          "max_value": "74",
          "description": "坡体中存在顺坡向缓倾的软弱结构面或组合体：不贯通；坡体中存在顺坡向缓倾的硬性结构面或组合体：贯通"
        },
        {
          "id": "moderate",
          "min_value": "25",
          "max_value": "49",
          "description": "坡体中存在顺坡向缓倾的硬性结构面或组合体：不贯通；坡体中存在其他方向结构面，且贯通和发育"
        },
        {
          "id": "low",
          "min_value": "0",
          "max_value": "24",
          "description": "坡体中其他方向的结构面，不贯通，不发育"
        }
      ]
    },
    {
      "id": "X23",
      "label": "地下水",
      "category": "地质条件",
      "source_pages": [
        20
      ],
      "notes": "根据地下水的分布范围和地下水的类型及边坡体的储水构造确定。基岩承压水取大值，基岩裂隙和土层孔隙潜水取小值。",
      "grades": [
        {
          "id": "very_high",
          "min_value": "75",
          "max_value": "100",
          "description": "边坡下部0.25H范围内有地下水出露，且无排水措施"
        },
        {
          "id": "high",
          "min_value": "50",
          "max_value": "74",
          "description": "边坡中下部（0.25～0.5）H范围内有地下水，且无排水措施"
        },
        {
          "id": "moderate",
          "min_value": "25",
          "max_value": "49",
          "description": "边坡中上部（0.5～0.75）H范围内有地下水，且无排水措施"
        },
        {
          "id": "low",
          "min_value": "0",
          "max_value": "24",
          "description": "边坡上部（0.75～1.0）H范围内有地下水，且无排水措施"
        }
      ]
    },
    {
      "id": "X31",
      "label": "施工季节",
      "category": "诱发因素",
      "source_pages": [
        20,
        21
      ],
      "notes": "根据边坡所在区域的降雨等级进行确定。如没有过去5年内年均降雨量资料，可用当地的年降雨量数据代替5年内年均降雨。超过1000mm，分值为100，其他分值可按实际值线性内插取值。",
      "grades": [
        {
          "id": "very_high",
          "min_value": "75",
          "max_value": "100",
          "description": "雨季施工，施工周期内出现暴雨；或施工地区过去5年内年均降雨超过800mm"
        },
        {
          "id": "high",
          "min_value": "50",
          "max_value": "74",
          "description": "雨季施工，施工周期内出现大雨；或施工地区过去5年内年均降雨600–800mm"
        },
        {
          "id": "moderate",
          "min_value": "25",
          "max_value": "49",
          "description": "雨季施工，施工周期内出现中雨；或施工地区过去5年内年均降雨300–600mm"
        },
        {
          "id": "low",
          "min_value": "0",
          "max_value": "24",
          "description": "旱季施工；施工周期内出现小雨或不降雨；或施工地区过去5年内年均降雨不超过300mm"
        }
      ]
    },
    {
      "id": "X32",
      "label": "自然灾害的影响",
      "category": "诱发因素",
      "source_pages": [
        21
      ],
      "notes": "自然灾害指施工区域暴雨、洪水、泥石流、崩塌、滑坡等，自然灾害多发季节施工取大值。",
      "grades": [
        {
          "id": "very_high",
          "min_value": "75",
          "max_value": "100",
          "description": "自然灾害频发"
        },
        {
          "id": "high",
          "min_value": "50",
          "max_value": "74",
          "description": "自然灾害多发"
        },
        {
          "id": "moderate",
          "min_value": "25",
          "max_value": "49",
          "description": "自然灾害偶发"
        },
        {
          "id": "low",
          "min_value": "0",
          "max_value": "24",
          "description": "自然灾害很少"
        }
      ]
    },
    {
      "id": "X41",
      "label": "工程措施类型",
      "category": "施工环境",
      "source_pages": [
        21
      ],
      "notes": "本指标只考虑边坡处治采用单一的工程措施。一个边坡采用多种工程措施时，取施工难度较大的工程措施对应的分值，并酌情提高取值。",
      "grades": [
        {
          "id": "very_high",
          "min_value": "75",
          "max_value": "100",
          "description": "抗滑桩"
        },
        {
          "id": "high",
          "min_value": "50",
          "max_value": "74",
          "description": "锚固工程"
        },
        {
          "id": "moderate",
          "min_value": "25",
          "max_value": "49",
          "description": "注浆类工程"
        },
        {
          "id": "low",
          "min_value": "0",
          "max_value": "24",
          "description": "挡土墙工程"
        }
      ]
    },
    {
      "id": "X42",
      "label": "周边环境",
      "category": "施工环境",
      "source_pages": [
        21,
        22
      ],
      "notes": "上边坡为土质、岩层产状顺层的边坡取大值；岩质边坡岩层产状反倾的边坡取小值。下边坡位于沟谷地带、地形较陡的、有河流水体的取大值；反之，取小值。如果上下自然边坡高陡，虽离路堑边坡水平距离较大，但也受到影响的，应酌情提高指标取值。",
      "grades": [
        {
          "id": "very_high",
          "min_value": "75",
          "max_value": "100",
          "description": "在坡顶开挖线以外0.5H、路基下方1.0H范围内有地表建筑物、地下埋藏物、高压线塔、水体设施"
        },
        {
          "id": "high",
          "min_value": "50",
          "max_value": "74",
          "description": "在坡顶开挖线以外1.0H、路基下方1.5H范围内有地表建筑物、地下埋藏物、高压线塔、水体设施"
        },
        {
          "id": "moderate",
          "min_value": "25",
          "max_value": "49",
          "description": "在坡顶开挖线以外1.5H、路基下方2.0H范围内有地表建筑物、地下埋藏物、高压线塔、水体等设施"
        },
        {
          "id": "low",
          "min_value": "0",
          "max_value": "24",
          "description": "设施位于上述范围以外"
        }
      ]
    },
    {
      "id": "X51",
      "label": "地质资料",
      "category": "资料完整性",
      "source_pages": [
        22,
        23
      ],
      "notes": "对地形地貌、地层岩性、地质构造、水文地质条件调查分析清楚，岩土计算参数选取依据充分的取小值；调查分析不太清楚、依据欠充分的取大值；缺乏调查分析，无依据的提高一档进行指标赋值，最高分为100。",
      "grades": [
        {
          "id": "very_high",
          "min_value": "75",
          "max_value": "100",
          "description": "每个高边坡工点有一个或没有勘察断面，每个断面仅有1个或没有勘探点（钻探、挖探、物探）"
        },
        {
          "id": "high",
          "min_value": "50",
          "max_value": "74",
          "description": "每个高边坡工点至少有一个勘察断面，每个断面有2个勘探点（钻探、挖探、物探）"
        },
        {
          "id": "moderate",
          "min_value": "25",
          "max_value": "49",
          "description": "每个高边坡工点至少有一个勘察断面，每个断面有3个勘探点（钻探、挖探、物探）"
        },
        {
          "id": "low",
          "min_value": "0",
          "max_value": "24",
          "description": "每个高边坡工点至少有一个勘察断面，每个断面至少有3个钻探和挖探点"
        }
      ]
    },
    {
      "id": "X52",
      "label": "设计文件",
      "category": "资料完整性",
      "source_pages": [
        23,
        24
      ],
      "notes": "完整的图件包括平面图、立面图、断面图、结构图及大样图等。",
      "grades": [
        {
          "id": "very_high",
          "min_value": "75",
          "max_value": "100",
          "description": "一坡一图一说明图件不完整"
        },
        {
          "id": "high",
          "min_value": "50",
          "max_value": "74",
          "description": "一坡一图一说明图件较完整"
        },
        {
          "id": "moderate",
          "min_value": "25",
          "max_value": "49",
          "description": "一坡一图一说明图件完整，有计算参数，有边坡破坏力大小（如滑坡推力），有破裂面位置"
        },
        {
          "id": "low",
          "min_value": "0",
          "max_value": "24",
          "description": "一坡一图一说明图件很完整，有计算参数，有边坡破坏力大小（如滑坡推力），有破裂面位置，有工程措施的抗滑力（如抗滑桩的抗滑力），提出施工安全工况、特殊工程的施工工艺及注意事项、施工风险分析及控制措施"
        }
      ]
    }
  ],
