+                work.cancel()
+                with pytest.raises(asyncio.CancelledError):
+                    await work
+            with pytest.raises(ActionRejected, match='^ARTIFACT_TEXT_WORK_OUTCOME_UNRESOLVED'):
+                await tool('cancelled', ['rule-comparison'], [receipt])
